{
  "name": "@mushaf/extension",
  "version": "0.3.0",
  "private": true,
  "description": "The Mushaf as an extension of another app: the reader in one HTML file, its fonts fetched by the app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && node scripts/manifest.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@mushaf/core": "workspace:*",
    "@mushaf/packs": "workspace:*",
    "@mushaf/reader": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
