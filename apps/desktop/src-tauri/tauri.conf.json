{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mushaf",
  "mainBinaryName": "mushaf-desktop",
  "version": "0.1.0",
  "identifier": "app.mushaf.desktop",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "مصحف — Mushaf",
        "width": 1280,
        "height": 900,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#f2eee4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self' mushaf: http://mushaf.localhost data:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "The Madinah Mushaf, opened while your coding agent works",
    "copyright": "Code MIT; Quran text and fonts © King Fahd Glorious Quran Printing Complex",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
